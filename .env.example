# Supabase — Project Settings > API
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_ANON_KEY=<anon key>             # para verificar JWTs no login
SUPABASE_SERVICE_ROLE_KEY=<service role> # para criar usuários (nunca expor no Dash)

# Segurança
ALLOWED_ORIGINS=http://localhost:8050    # URL do Dash (CORS)